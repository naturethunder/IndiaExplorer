# ==============================================================================
# IndiaExplorer Image Pipeline API Keys (Example Template)
# ==============================================================================

# Google Places API (Places API New / Place Photos)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Maps Embed API (Used to embed interactive maps on destination detail pages)
# Free with unlimited usage. Enable "Maps Embed API" in Google Cloud Console.
# Strongly recommended: Restrict key to HTTP referrers (e.g. https://exploredesh.com/*)
GOOGLE_MAPS_EMBED_API_KEY=your_google_maps_embed_api_key_here

# Pixabay API - https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Openverse API - https://api.openverse.org/v1/
OPENVERSE_CLIENT_ID=your_openverse_client_id_here
OPENVERSE_CLIENT_SECRET=your_openverse_client_secret_here

# Pexels API - https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash API - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here