{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "ExploreDesh Go — Bharat Offline Travel Companion",
  "short_name": "ExploreDesh Go",
  "description": "High-performance offline pocket travel guides, emergency toolkit, and itineraries across 2,393 destinations in India.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#080A0F",
  "theme_color": "#080A0F",
  "orientation": "any",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": [
    "travel",
    "navigation",
    "utilities"
  ],
  "icons": [
    {
      "src": "images/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "images/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Saved Pocket Guides",
      "short_name": "Pocket Guides",
      "description": "Open downloaded offline pocket guides for zero-connectivity travels",
      "url": "/#offline-guides",
      "icons": [
        {
          "src": "images/pwa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Himalayan Emergency Toolkit",
      "short_name": "Emergency SOS",
      "description": "Himalayan mountain rescue, AMS checklist, and national emergency contacts",
      "url": "/#emergency-sos",
      "icons": [
        {
          "src": "images/pwa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Explore All Destinations",
      "short_name": "Destinations",
      "description": "Browse 2,393 verified destinations across India",
      "url": "/destinations.html",
      "icons": [
        {
          "src": "images/pwa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
