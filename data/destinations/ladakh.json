edia.org/wikipedia/commons/0/0c/Great_Chorten_at_Tikse.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","https://upload.wikimedia.org/wikipedia/commons/e/ee/Thiksey_monastery%2C_Leh.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","https://upload.wikimedia.org/wikipedia/commons/d/d5/Bharat_Mata_at_Indian_Army_base_gate.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original"]},{"name":"Nubra Valley","category":"adventure","distance":"150 km from Leh","entryFee":"Inner Line Permit","timings":"Jun–Oct","duration":"2 days","rating":4.8,"description":"Double-humped Bactrian camels on sand dunes at 3,000m. Via Khardung La.","image":{"src":"https://upload.wikimedia.org/wikipedia/commons/3/3b/Nubra_Sand_Dunes.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","alt":"Nubra Valley"},"photos":["https://upload.wikimedia.org/wikipedia/commons/b/b4/Land_of_Sand_Dunes%21_-_Nubra_Valley.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","https://upload.wikimedia.org/wikipedia/commons/4/43/A_Golden_Bowl.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","https://upload.wikimedia.org/wikipedia/commons/c/cc/Shyok_river_at_Hunder%2C_Nubra_valley.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original"]},{"name":"Shanti Stupa","category":"spiritual","distance":"5 km from Leh","entryFee":"Free","timings":"5 AM – 9 PM","duration":"1.5 hrs","rating":4.6,"description":"White-domed Buddhist stupa on a hilltop. Best sunrise and sunset spot in Leh.","image":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/1f/Shanti_Stupa%2C_Dhauli_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","alt":"Shanti Stupa"},"photos":["https://upload.wikimedia.org/wikipedia/commons/7/78/Shanti_Stupa%2C_Dhauli_02.jpg?utm_source=commons.wikimedia.org&utm_campaign=imagein